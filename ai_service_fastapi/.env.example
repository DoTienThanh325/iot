# Copy/export deliberately; the application does not auto-load this file.
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB=iot_stroke_db
AI_STORAGE_MODE=mongo
AI_MONGO_TIMEOUT_MS=3000
AI_MAX_CONCURRENCY=2
AI_MAX_SAMPLES=30000
AI_MAX_WINDOW_SECONDS=60
AI_MAX_BODY_BYTES=4000000
# For a one-worker local demonstration only: AI_STORAGE_MODE=memory
# Mount a trusted, evaluated artifact directory to enable model inference:
# AI_MODEL_DIR=/app/models/afib-v2
AI_MODEL_REQUIRED=false
AI_ALLOW_SYNTHETIC_MODEL=false
